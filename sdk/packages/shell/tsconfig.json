{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@txresbench/kit": ["../kit/src/index.ts"],
      "@txresbench/kit/*": ["../kit/src/*"],
      "@txresbench/framework": ["../framework/src/index.ts"],
      "@txresbench/framework/*": ["../framework/src/*"]
    }
  },
  "include": ["src"]
}
