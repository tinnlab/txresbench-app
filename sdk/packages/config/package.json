{
  "name": "@txresbench/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared dev-config + design-token quality-gate tooling for txresbench-SDK apps: biome preset, tsconfig base, syncpack policy, and parameterized design-contract lints.",
  "exports": {
    "./biome": "./biome.base.json",
    "./biome.base.json": "./biome.base.json",
    "./tsconfig": "./tsconfig.base.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./syncpack": "./syncpack.base.mjs",
    "./check": "./src/check.mjs",
    "./lint/*": "./src/lint/*"
  },
  "bin": {
    "txresbench-check": "./src/check.mjs",
    "txresbench-lint-colors": "./src/lint/hardcoded-colors.mjs",
    "txresbench-lint-settings-field": "./src/lint/settings-field.mjs",
    "txresbench-lint-adjacent-inline": "./src/lint/adjacent-inline.mjs",
    "txresbench-lint-logical-direction": "./src/lint/logical-direction.mjs",
    "txresbench-lint-tooltip-placement": "./src/lint/tooltip-placement.mjs",
    "txresbench-design-spec": "./src/lint/design-spec.mjs",
    "txresbench-kit-manifest": "./src/lint/kit-manifest.mjs"
  },
  "scripts": {
    "test": "node ../../scripts/run-node-tests.mjs --min 3"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
