# Rust
/target
**/target
Cargo.lock.bak

# Generated migration-merge artifact (build.rs composes it fresh each build)
src-app/server/migrations-merged/

# Build-time sqlx verification DB file (sqlite leg of the build-DB provisioner,
# DEC-14: <worktree>/target/sqlx-build/<prefix><key>.sqlite). The blanket
# **/target rule already covers it; the explicit entry names the artifact so
# the ignore intent survives a narrowing of that rule.
target/sqlx-build/

# Per-machine config (seeded from dev.example.yaml; carries jwt.secret + db creds)
config/dev.yaml
src-app/server/config/dev.yaml
config/web.yaml
src-app/server/config/web.yaml
# Per-machine local-run config (carries a real jwt.secret — never commit)
config/live.yaml
src-app/server/config/live.yaml

# Local app data tree (per-machine). The engine is one embedded SQLite file in
# the app data dir (CYTO_APP_DATA_DIR, or the desktop's ~/.txresbench); the
# framework's dev tree below is kept for the same reason — never commit either.
/cytoanalyst-data/
*.log

# Tauri codegen (regenerated by tauri-build)
src-app/desktop/tauri/gen/

# Node
node_modules
node_modules/
**/node_modules/
dist/
.vite/
**/.vite/

# Landing page build output (scripts/build-landing-site.mjs writes site/dist,
# the GitHub Pages publish root; regenerated at build time).
site/dist/

# Site test suite scratch (site/tests/*.test.mjs write their hermetic
# fixtures here, under a per-process subdir; never source).
site/tests/.tmp/

# OS
.DS_Store

# Playwright
src-app/ui/test-results/
src-app/ui/playwright-report/

# Analysis env-image cache (`just env-rootfs` / scripts/fetch-env-rootfs.sh).
# A ~300 MB squashfs + its digest sidecar + transient squashfuse mount points.
# Fetched once from ghcr.io and reused; never source.
.cyto-cache/

# gallery runtime-health outputs (generated)
src-app/ui/src/dev/gallery/RUNTIME_FINDINGS.*

# Build-time-generated analysis rootfs (docker-built by build.rs; embedded via include_bytes!). Not source.
src-app/server/binaries/sandbox-rootfs/rootfs.squashfs
src-app/server/binaries/sandbox-rootfs/.version

# Build-fetched / vendored artifacts (hub-seed, biomcp, stubs; vendored pgvector source).
# Downloaded or generated by build.rs / build helpers — not tracked source.
src-app/server/binaries/
src-app/server/vendor/
# Staged/build-fetched hub-seed (this app stages it under resources/, not binaries/).
src-app/server/resources/hub-seed/
src-app/server/config/dev.local.yaml

# Python bytecode caches (two `.pyc` blobs were committed under
# `src-app/server/src/modules/sandbox/processors/scripts/` — pure diff noise).
__pycache__/
*.py[cod]

# Per-worktree lifecycle scope (untracked by design — see .git/hooks/pre-push).
# One owner name, e.g. `stage3`. Absent => the gate judges every scope, which is the
# correct behaviour for a single-owner lifecycle and for a finished branch.
.lifecycle/.scope
src-app/ui/src/dev/gallery/RUNTIME_RUN.json
