# TxResBench — agent-kit app.config.
#
# Plain KEY=value data file, READ (never sourced) by the shared lifecycle scripts
# symlinked from the agent-kit submodule (.claude/lifecycle → ../agent-kit/lifecycle).
# Every key is OPTIONAL; an UNSET key SKIPS its check/gate. This is the seam that
# de-txresbench-ifies the scripts (agent-kit C-1) so TxResBench runs them unchanged.
# Full contract: agent-kit/app.config.example.

# ── preflight.sh (Phase-1 environment gate) ───────────────────────────────
# TxResBench has NO hub-seed and NO vendored build submodule → those two checks
# are skipped (keys omitted). One npm workspace (desktop reuses src-app/ui/dist).
PREFLIGHT_NODE_WORKSPACES=src-app/ui
# (ITEM-26: the app's build DB is the per-worktree SQLite FILE — the shared
# local postgres cluster key is GONE with the engine swap; the preflight's
# local-cluster pattern is the sqlite sentinel only. The SDK's own standalone
# postgres leg keeps its :54321 cluster, but that build is not preflighted.)
# Per-worktree build-DB isolation gate: build scripts auto-key their build DB by
# worktree (cluster DB name, or the sqlite build file under target/sqlx-build/).
# The env var is the SDK's opt-out (=0 disables isolation); the sentinel is the
# committed build-DB marker — the sqlite build file name in
# `.cargo/config.toml`'s DATABASE_URL — so an external DATABASE_URL override
# that does not carry it is flagged.
PREFLIGHT_BUILD_DB_ENV=TXR_BUILD_DB_PERWORKTREE
PREFLIGHT_BUILD_DB_SENTINEL=txresbench_build.sqlite
PREFLIGHT_CONFIG_DIR=src-app/server/config
PREFLIGHT_CONFIG_FILE=dev.yaml
PREFLIGHT_CONFIG_EXAMPLE=dev.example.yaml
PREFLIGHT_CONFIG_PLACEHOLDER=CHANGE_ME_run_openssl_rand_base64_48

# ── merge-gate.mjs (merge-time gate) ──────────────────────────────────────
# Per-module migrations (src/modules/*/migrations, composed into migrations-merged
# at build time). C2 scans this root recursively for duplicate <prefix> collisions
# across ALL modules — the check that catches two parallel branches grabbing the
# same 202608xxxx prefix (the newer merge-gate fails-closed if this is unset).
MERGE_MIGRATIONS_DIR=src-app/server/src/modules
MERGE_CARGO_PACKAGE=txresbench
MERGE_CARGO_DIR=src-app/server
MERGE_CARGO_DESKTOP_PACKAGE=txresbench-desktop
MERGE_DESKTOP_TOUCH_PREFIX=src-app/desktop/tauri/
MERGE_REGEN_CMD=just openapi-regen
# `just openapi-regen` writes FIVE files (`finish_and_emit` in the sdk's
# openapi/mod.rs does five unconditional fs::write calls). This list named only
# the first two for months, and C3 scoped its parity diff TO the list — so a
# merge that resolved permissions.ts / permissionDescriptions.ts /
# apiEndpoints.ts by taking a side passed the gate. C3 no longer scopes to this
# list (it diffs the whole merged tree after the regen); the list is the expected
# set, and C6 generated-coverage FAILS if the regen writes a path not named here.
# Two-spec client seam (#50): `just openapi-regen` now runs TWO cargo passes — default
# (saas-OFF) AND `--features saas` — writing TEN files (5 per client). The saas pass emits
# `openapi-saas/openapi.json` + `api-client-saas/{types,permissions,permissionDescriptions,
# apiEndpoints}.ts` (billing::admin + billing endpoints/types PRESENT). ALL TEN are listed so
# C3 regen-parity reproduces both trees and C6 generated-coverage FAILS if a regen writes a path
# not named here. The gate is now STRICTER (covers both specs), never looser.
MERGE_GENERATED=src-app/ui/openapi/openapi.json src-app/ui/src/api-client/types.ts src-app/ui/src/api-client/permissions.ts src-app/ui/src/api-client/permissionDescriptions.ts src-app/ui/src/api-client/apiEndpoints.ts src-app/ui/openapi-saas/openapi.json src-app/ui/src/api-client-saas/types.ts src-app/ui/src/api-client-saas/permissions.ts src-app/ui/src/api-client-saas/permissionDescriptions.ts src-app/ui/src/api-client-saas/apiEndpoints.ts
# Staging provisioning. The gate's staging worktree gets the TRACKED tree only:
# the `sdk` submodule's working tree would be EMPTY (⇒ C1/C3 die with
# `failed to read sdk/crates/sandbox-seccomp/Cargo.toml`) and the gitignored
# per-machine server config would be absent (⇒ `just openapi-regen` dies with
# `no config file found`). merge-gate checks submodules out automatically
# (MERGE_STAGING_SUBMODULES defaults to 1); the dev config must be DECLARED:
MERGE_STAGING_COPY_FILES=src-app/server/config/dev.yaml

# ── lifecycle-check.mjs (per-phase gate) ──────────────────────────────────
# One frontend workspace; BOTH OpenAPI specs drive the e2e route-mock gate (R2-5) so a saas-page
# spec that mocks a `/api/billing/*` or `/api/admin/accounts/*` route (present only in the saas
# spec, #50) still validates against a live route instead of silently no-op'ing. Listing the saas
# spec here widens the route universe the gate accepts — it never narrows it.
LIFECYCLE_FRONTEND_WORKSPACES=src-app/ui/:ui
LIFECYCLE_OPENAPI_SPECS=src-app/ui/openapi/openapi.json src-app/ui/openapi-saas/openapi.json
