# cloud-sim — the DE-INV-13 Level-1 portability gate (epic T1, ITEM-10).
#
# Runs the Level-1 emulator tier (`just cloud-sim-test-l1`) PER-COMMIT: the
# SaaS compute+storage path is exercised against the local simulation substrate
# (minio + fake-gcs-server + dev Postgres) with NO cloud credentials present, so
# the "runs on k8s / AWS / GCP" portability claim is continuously verified
# rather than trusted.
#
# ENFORCEMENT IS EXTERNALLY BLOCKED (DEC-7 / GRAPH external-blocker #1): ziee-ai
# Actions billing is dark org-wide, so this workflow does not execute in CI yet.
# The binding gate until it is restored is LOCAL: `just cloud-sim-test-l1`. This
# file is authored now so the gate turns on the moment CI is back — it is a
# recorded external blocker, not a descope. Mirrors env-images.yml's shape.
#
# The Level-2 tier (kind + KEDA) is PRE-RELEASE (DEC-4), not wired here.
name: cloud-sim

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch: {}

permissions:
  contents: read

jobs:
  level1:
    runs-on: ubuntu-latest
    services:
      # The dev/test Postgres the KEDA scaler + harness read (reuses :54321).
      postgres:
        image: postgres:18
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: password
          POSTGRES_DB: postgres
        ports:
          - "54321:5432"
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - name: Install just + mc
        # Pin both tools to a specific version for a reproducible, less
        # supply-chain-exposed CI leg (an unpinned `curl | bash` / moving
        # `mc/release` runs whatever the vendor host serves that day).
        run: |
          curl -fsSL https://just.systems/install.sh | bash -s -- --tag 1.36.0 --to /usr/local/bin
          curl -fsSL -o /usr/local/bin/mc "https://dl.min.io/client/mc/release/linux-amd64/archive/mc.RELEASE.2025-04-16T18-13-26Z"
          chmod +x /usr/local/bin/mc
      - name: Level-1 cloud-sim tier (credential-free)
        # The no-cloud-creds guard runs FIRST inside the recipe; the runner has no
        # cloud identity, so a real cred present here is itself a failure signal.
        run: just cloud-sim-test-l1
