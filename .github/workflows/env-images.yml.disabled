# Builds + pushes the analysis env images to GHCR and cosign keyless-signs them.
# TRIGGERS (tag-triggered signed publish is TESTABLE PRE-MERGE — no "merge to test"):
#   - a tag `env-v*` (e.g. `env-v0-test`, `env-v0.1.0`) → publishes from ANY commit;
#     the OIDC identity is `…/env-images.yml@refs/tags/env-v*`, which the runtime's
#     ref-flexible `cosign_verify` accepts. This is the pre-merge / release path.
#   - a push to `main` → auto-republish, but ONLY when the rootfs recipe changed
#     (the `gate` job enforces "only build when the file changes on main", FB-6).
#   - `workflow_dispatch` (usable once the workflow is on the default branch).
# Fetch-newest (DEC-I/ITEM-12): each run re-points the moving `schema<N>-latest-<arch>`
# tag the runtime resolves + pushes the immutable `schema<N>-<sha>-<arch>` provenance tag.
# x86_64 on a native runner; arm64 DEFERRED (one commented matrix row).
name: env-images

on:
  push:
    branches: [main]
    tags:
      - 'env-v*'
  workflow_dispatch: {}

permissions:
  contents: read
  packages: write         # GHCR push
  id-token: write         # cosign keyless (Fulcio/Rekor OIDC) — the reason this needs Actions

env:
  # NOTE there is deliberately NO workflow-level `ENV_ID`. It used to be the scalar
  # `single-cell`, while the gate below fires on any change under `src-app/env-rootfs/` —
  # so editing the *R* recipe triggered a rebuild-and-republish of the *python* moving
  # tag, and the R image had no publish path at all. ENV_ID is now per-job, from a matrix
  # DISCOVERED off the recipe tree (see the `gate` job's `envs` output).
  REGISTRY: ghcr.io
  # per-env repo: ghcr.io/<owner>/txresbench-env/<env>
  REPO_PREFIX: txresbench-env

jobs:
  # Decide whether to build. Tags + manual dispatch ALWAYS build (the pre-merge /
  # release path); a push to `main` builds ONLY when the recipe changed (FB-6). This
  # is a job-level guard rather than a `push.paths` filter, because `paths` would also
  # suppress tag pushes (a tag on an existing commit has no "changed" recipe files).
  gate:
    runs-on: ubuntu-latest
    outputs:
      build: ${{ steps.d.outputs.build }}
      envs: ${{ steps.d.outputs.envs }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # ONE step decides BOTH questions, because they are the same question: not
      # "should anything build?" but "WHICH ENVS should build?". Splitting them is how the
      # scalar-ENV_ID bug survived its first fix — the trigger fired tree-wide while the
      # published env was fixed, so editing the R recipe republished the python image.
      #
      # The env set is DISCOVERED, never listed. A directory under `env-rootfs/` holding a
      # `Dockerfile` is one env — the same rule `rootfs::version::discover_env_recipes`,
      # `build_helper/sandbox_rootfs.rs` and `scripts/publish-env-rootfs.sh` all apply.
      # Listing them would put analysis-domain vocabulary into CI and would go stale the
      # next time a recipe lands.
      - id: d
        run: |
          set -euo pipefail
          # `sed`, not `xargs -n1 basename`: with no recipes at all, xargs invokes
          # `basename` with no operand, which errors under `pipefail` BEFORE the
          # empty-set branch below can report anything useful. sed handles empty input.
          all=$(find src-app/env-rootfs -mindepth 2 -maxdepth 2 -name Dockerfile \
                  -exec dirname {} \; | sed 's#.*/##' | sort)
          if [ -z "$all" ]; then
            echo "no env recipe found under src-app/env-rootfs" >&2; exit 1
          fi
          emit() {
            json=$(printf '%s\n' "$1" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
            if [ "$json" = "[]" ]; then
              echo "build=no" >> "$GITHUB_OUTPUT"; echo "envs=[]" >> "$GITHUB_OUTPUT"
              echo "no env recipe changed — nothing to publish"
            else
              echo "build=yes" >> "$GITHUB_OUTPUT"; echo "envs=$json" >> "$GITHUB_OUTPUT"
              echo "will build: $json"
            fi
            exit 0
          }

          # Tags + manual dispatch ALWAYS build EVERY env (the pre-merge / release path);
          # a tag on an existing commit has no "changed" recipe files, which is why this is
          # a job-level guard rather than a `push.paths` filter.
          if [ "${{ github.ref_type }}" = "tag" ] || [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            emit "$all"
          fi
          base="${{ github.event.before }}"
          if [ -z "$base" ] || [ "$base" = "0000000000000000000000000000000000000000" ]; then
            emit "$all"
          fi
          # `-z` (and translating the NULs) rather than plain `--name-only`: git QUOTES a
          # non-ASCII path under the default `core.quotePath`, and the leading `"` defeats
          # the `^src-app/env-rootfs/` anchor below — so a recipe file with an accented
          # name would silently never trigger a rebuild.
          #
          # And a git FAILURE is not "nothing changed". A base SHA git cannot resolve
          # (a force-push, a GC'd object) used to be swallowed into `build=no`, silently
          # skipping the publish of a genuinely changed recipe. A publish gate must fail
          # SAFE — that means building everything, not nothing.
          if ! changed=$(git diff -z --name-only "$base" "${{ github.sha }}" | tr '\0' '\n'); then
            echo "cannot diff $base..${{ github.sha }} (force-push? GC'd object?) — building every env rather than assuming nothing changed" >&2
            emit "$all"
          fi

          # A change to the schema constant or to THIS WORKFLOW affects every env, so all
          # of them rebuild. (The pattern matches the parked `.disabled` name too — the
          # workflow that ships in this repository is the disabled one, and the old
          # pattern silently never matched it.)
          if printf '%s\n' "$changed" | grep -qE '^src-app/server/src/modules/rootfs/version\.rs$|^\.github/workflows/env-images\.yml(\.disabled)?$'; then
            emit "$all"
          fi

          # OTHERWISE: only the envs whose OWN recipe directory changed. This is the half
          # the first fix missed. Re-pointing a moving tag is what a running deployment
          # resolves, so republishing an image whose recipe did not move is not a no-op —
          # it hands every host a new digest for no reason, and it did so using a build of
          # a DIFFERENT env's change.
          printf '%s\n' "$all" > /tmp/all-envs
          touched=$(printf '%s\n' "$changed" \
                    | sed -n 's#^src-app/env-rootfs/\([^/]*\)/.*#\1#p' \
                    | sort -u | grep -Fx -f /tmp/all-envs || true)
          emit "$touched"


  build:
    needs: gate
    if: needs.gate.outputs.build == 'yes'
    strategy:
      fail-fast: false
      matrix:
        # BOTH are real matrix DIMENSIONS, so the job set is env x arch. `arch` is not an
        # `include`-only key, and that distinction is load-bearing: an `include` entry
        # whose keys are not dimensions is merged into EVERY combination and a later such
        # entry OVERWRITES an earlier one. With `arch` living only in `include`,
        # uncommenting the arm64 row below would not have added arm64 jobs — it would have
        # turned every job arm64 and silently stopped publishing amd64 altogether.
        env_id: ${{ fromJSON(needs.gate.outputs.envs) }}
        arch: [amd64]
        include:
          # Keyed on a real dimension VALUE, so this only supplies `runner` to the amd64
          # combinations rather than to all of them.
          - arch: amd64
            runner: ubuntu-latest          # native x86_64
          # arm64 DEFERRED (private repo has no free GitHub arm64 runner; path proven —
          # all wheels available + arch-agnostic Dockerfile). To publish arm64 you must do
          # BOTH: add `arm64` to the `arch:` LIST above **and** uncomment this runner
          # mapping. Uncommenting only the mapping does not leave a runnerless combination
          # — it is worse than that: `arch: arm64` matches no existing combination, so
          # GitHub APPENDS it as a job of its own with NO `env_id`, which would run
          # `docker build -f src-app/env-rootfs//Dockerfile`. Adding only the list value
          # is the harmless half (that combination simply has no runner).
          # - arch: arm64
          #   runner: ubuntu-24.04-arm
    runs-on: ${{ matrix.runner }}
    env:
      ENV_ID: ${{ matrix.env_id }}
    outputs:
      schema: ${{ steps.meta.outputs.schema }}
    steps:
      - uses: actions/checkout@v4

      - name: Resolve schema version (lockstep with rootfs/version.rs)
        id: meta
        run: |
          # Match ONLY the `const ROOTFS_SCHEMA_VERSION: u32 = N;` line (not the test
          # asserts) and take the value N (tail -1 skips the `32` in `u32`).
          schema=$(grep -E 'const ROOTFS_SCHEMA_VERSION' \
            src-app/server/src/modules/rootfs/version.rs | grep -oE '[0-9]+' | tail -1)
          echo "schema=$schema" >> "$GITHUB_OUTPUT"
          echo "sha=${GITHUB_SHA::12}" >> "$GITHUB_OUTPUT"
          echo "repo=${REGISTRY}/${GITHUB_REPOSITORY_OWNER}/${REPO_PREFIX}/${ENV_ID}" >> "$GITHUB_OUTPUT"

      - name: Build the rootfs squashfs (native ${{ matrix.arch }} — no emulation)
        run: |
          docker build -f src-app/env-rootfs/${ENV_ID}/Dockerfile \
            --build-arg ROOTFS_SCHEMA_VERSION=${{ steps.meta.outputs.schema }} \
            -t rootfs-build:${{ matrix.arch }} src-app/env-rootfs/${ENV_ID}
          cid=$(docker create rootfs-build:${{ matrix.arch }})
          docker cp "$cid":/rootfs.squashfs ./${ENV_ID}.squashfs
          docker rm "$cid"
          ls -lh ${ENV_ID}.squashfs

      - name: Install oras + cosign
        run: |
          curl -sSL https://github.com/oras-project/oras/releases/download/v1.2.0/oras_1.2.0_linux_${{ matrix.arch }}.tar.gz | tar -xz oras && sudo mv oras /usr/local/bin/
          curl -sSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/download/v2.4.1/cosign-linux-${{ matrix.arch }} && sudo chmod +x /usr/local/bin/cosign

      - name: Login to GHCR
        run: echo "${{ secrets.GITHUB_TOKEN }}" | oras login ${REGISTRY} -u ${{ github.actor }} --password-stdin

      - name: Push per-arch (immutable sha tag + moving latest) + cosign keyless sign
        env:
          REPO: ${{ steps.meta.outputs.repo }}
          S: ${{ steps.meta.outputs.schema }}
          SHA: ${{ steps.meta.outputs.sha }}
        run: |
          # immutable (provenance pins this) + moving 'newest for this schema+arch' (runtime resolves this)
          oras push \
            --artifact-type application/vnd.txresbench.env-rootfs.squashfs.v1 \
            --annotation "org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}" \
            --annotation "org.opencontainers.image.revision=${{ github.sha }}" \
            --annotation "com.txresbench.rootfs.schema=${S}" \
            --annotation "com.txresbench.env=${ENV_ID}" \
            --annotation "com.txresbench.arch=${{ matrix.arch }}" \
            "${REPO}:schema${S}-${SHA}-${{ matrix.arch }}" \
            ${ENV_ID}.squashfs:application/vnd.txresbench.env-rootfs.squashfs.v1
          oras tag "${REPO}:schema${S}-${SHA}-${{ matrix.arch }}" "schema${S}-latest-${{ matrix.arch }}"
          digest=$(oras resolve "${REPO}:schema${S}-${SHA}-${{ matrix.arch }}")
          echo "published ${REPO}@${digest} (schema${S}, ${{ matrix.arch }})"
          # keyless cosign sign (Fulcio cert = this repo's OIDC identity; the runtime verifies that identity)
          cosign sign --yes "${REPO}@${digest}"
