{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TxResBench",
  "mainBinaryName": "txresbench-desktop",
  "version": "0.1.0",
  "identifier": "org.tinnlab.txresbench",
  "build": {
    "beforeDevCommand": "npm run fetch-oras && npm run dev --workspace=@txresbench/ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run fetch-oras && npm run build --workspace=@txresbench/ui",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/pretrained-bundled"],
    "externalBin": ["binaries/oras"],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": ["libseccomp2"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://tinnlab.github.io/txresbench-app/updates/latest.json"
      ]
    }
  }
}
