{
  "name": "@txresbench/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "preview": "vite preview",
    "check": "tsc --noEmit && npm run typecheck:tests && node scripts/collect-actions.mjs --check && node scripts/action-refs-lint.mjs && node scripts/action-coverage.mjs && node scripts/lint-no-domain-in-builtin.mjs && node scripts/lint-layer-boundary.mjs && node scripts/lint-positional-declaration.mjs && node scripts/lint-text-source-bytes.mjs && node scripts/lint-native-controls.mjs && node scripts/lint-secret-input-caps.mjs && npm run check:surface-baseline && npm run check:e2e-routing && npm run check:rename-mechanical && npm run test:unit",
    "check:e2e-routing": "node scripts/check-e2e-routing.mjs",
    "check:rename-mechanical": "node scripts/check-rename-mechanical.mjs",
    "test:e2e": "playwright test",
    "test:e2e:viz": "playwright test --config=playwright.viz.config.ts",
    "test:e2e:gallery": "playwright test --config=playwright.gallery.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:unit": "vitest run && npm run test:unit:node",
    "test:unit:node": "node scripts/run-node-tests.mjs",
    "gallery": "node scripts/gallery-dev.mjs",
    "viz-showcase": "node scripts/viz-showcase.mjs",
    "gallery:runtime": "node ../../node_modules/@txresbench/gallery/scripts/runtime-health.mjs",
    "gate:ui": "node ../../node_modules/@txresbench/gallery/scripts/gate-ui.mjs",
    "check:surface-baseline": "node scripts/capture-surface-baseline.mjs compare --baseline src/modules/workbench/core/__fixtures__/surface-baseline.main.json",
    "capture:surface-baseline": "node scripts/capture-surface-baseline.mjs capture --out src/modules/workbench/core/__fixtures__/surface-baseline.main.json --label \"origin/main re-capture\"",
    "lint:text-bytes": "node scripts/lint-text-source-bytes.mjs"
  },
  "dependencies": {
    "@deck.gl-community/editable-layers": "^9.3.7",
    "@deck.gl/aggregation-layers": "^9.3.6",
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/extensions": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/react": "^9.3.6",
    "@hms-dbmi/viv": "^0.22.0",
    "@luma.gl/core": "^9.3.6",
    "@observablehq/plot": "^0.6.17",
    "@tanstack/react-virtual": "^3.14.4",
    "@tauri-apps/api": "^2.11.0",
    "@xyflow/react": "^12.3.5",
    "@txresbench/dock": "*",
    "@txresbench/framework": "*",
    "@txresbench/kit": "*",
    "@txresbench/shell": "*",
    "@txresbench/viz": "*",
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "d3-polygon": "^3.0.1",
    "d3-scale-chromatic": "^3.1.0",
    "dagre": "^0.8.5",
    "jspdf": "^4.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.15.1",
    "react-use": "^17.6.0",
    "read-excel-file": "^9.3.14",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@deck.gl/test-utils": "^9.3.6",
    "@luma.gl/test-utils": "^9.3.6",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-array": "^3.2.1",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.10",
    "@txresbench/gallery": "*",
    "@txresbench/test-e2e": "*",
    "esbuild": "^0.25.0",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.10"
  }
}
