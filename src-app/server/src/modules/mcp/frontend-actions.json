{
  "version": 1,
  "actions": [
    {
      "id": "app.navigate",
      "title": "Navigate the app to a route",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "mcp::use",
      "params_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "features.clearAccountOverride",
      "title": "Clear a per-account feature-flag override (revert to inherit)",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "features::manage",
      "group": "Admin",
      "description": "Remove a feature flag's PER-ACCOUNT override for one account, so the account reverts to inheriting the global default (or the compiled default).",
      "params_schema": {
        "type": "object",
        "required": [
          "flag_key",
          "account_id"
        ],
        "additionalProperties": false,
        "properties": {
          "flag_key": {
            "type": "string",
            "minLength": 1,
            "description": "The flag key, e.g. \"demo.runtime_flag\"."
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "description": "The account UUID whose override should be cleared."
          }
        }
      }
    },
    {
      "id": "features.setAccountFlag",
      "title": "Enable or disable a feature flag for one account (per-account override)",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "features::manage",
      "group": "Admin",
      "description": "Set a PER-ACCOUNT override for a feature flag (on/off) for a single account, leaving the global default and other accounts untouched.",
      "params_schema": {
        "type": "object",
        "required": [
          "flag_key",
          "account_id",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "flag_key": {
            "type": "string",
            "minLength": 1,
            "description": "The flag key, e.g. \"demo.runtime_flag\"."
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "description": "The account UUID to override the flag for."
          },
          "enabled": {
            "type": "boolean",
            "description": "true enables the feature for this account, false disables it."
          }
        }
      }
    },
    {
      "id": "features.setGlobalFlag",
      "title": "Enable or disable a feature flag (global default)",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "features::manage",
      "group": "Admin",
      "description": "Set a feature flag's GLOBAL default on or off for the whole deployment (no per-account override).",
      "params_schema": {
        "type": "object",
        "required": [
          "flag_key",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "flag_key": {
            "type": "string",
            "minLength": 1,
            "description": "The flag key, e.g. \"demo.runtime_flag\"."
          },
          "enabled": {
            "type": "boolean",
            "description": "true enables the feature globally, false disables it."
          }
        }
      }
    },
    {
      "id": "mcp.updateSettings",
      "title": "Update MCP settings",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "mcp::settings::manage",
      "group": "Admin",
      "description": "Update the MCP agent/tool caps (max concurrent control sessions, max in-flight invokes per user, per-action wall-clock backstop, list-capabilities cap, invoke result-byte cap) and the pairing-code TTL. Each field is optional; omit to leave unchanged. Values are bounded (safety limits).",
      "params_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "max_control_sessions": {
            "description": "Global cap on live agent control sessions — an OOM safety limit (16..16384).",
            "type": "integer",
            "minimum": 16,
            "maximum": 16384
          },
          "max_inflight_per_user": {
            "description": "Per-user cap on concurrent in-flight invokes — a DoS safety limit (1..256).",
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "pairing_ttl_secs": {
            "description": "Pairing-code time-to-live, in seconds (30..3600).",
            "type": "integer",
            "minimum": 30,
            "maximum": 3600
          },
          "action_wall_clock_secs": {
            "description": "Outer wall-clock backstop on one dispatched action, in seconds (30..3600).",
            "type": "integer",
            "minimum": 30,
            "maximum": 3600
          },
          "max_list_results": {
            "description": "Cap on capabilities returned by one list_capabilities call (1..2000).",
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "max_result_bytes": {
            "description": "Cap on the invoke result body relayed to the model, in bytes — an OOM safety limit (1 KiB..64 MiB).",
            "type": "integer",
            "minimum": 1024,
            "maximum": 67108864
          }
        }
      }
    },
    {
