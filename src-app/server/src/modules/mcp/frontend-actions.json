    {
      "id": "jobs.updateSettings",
      "title": "Update job scheduler settings",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "jobs::settings::manage",
      "group": "Admin",
      "description": "Update the job settings (max concurrent jobs, per-tenant cap, reserved interactive slots, SSE keep-alive seconds + max clients, admission wait seconds + poll ms, and the scheduler/reaper timing knobs: heartbeat, reaper tick, stale threshold, max reclaims, reclaim batch, dispatch tick, metric tick). Each field is optional; omit to leave unchanged.",
      "params_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "max_concurrent_jobs": {
            "description": "Global max concurrent jobs.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "per_tenant_max_concurrent": {
            "description": "Per-tenant max concurrent jobs.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reserved_interactive_slots": {
            "description": "Slots reserved for interactive jobs.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sse_keep_alive_secs": {
            "description": "SSE heartbeat interval in seconds (1-300).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sse_max_clients": {
            "description": "Max concurrent per-job SSE subscribers (1-4096; OOM guard).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "admission_wait_secs": {
            "description": "Detached-admission wait budget in seconds (1-60).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "admission_poll_ms": {
            "description": "Admission poll interval in ms (10-10000; must be < wait*1000).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "heartbeat_secs": {
            "description": "Worker heartbeat cadence in seconds (1-60).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reaper_tick_secs": {
            "description": "Reaper sweep cadence in seconds (1-300).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "stale_threshold_secs": {
            "description": "Stale-reclaim threshold in seconds (5-3600; must be >= 3x heartbeat_secs).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max_reclaims": {
            "description": "Poison-job discard-at-max reclaim count (1-100).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reclaim_batch": {
            "description": "Bounded reclaim/discard batch per sweep (1-10000).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "dispatch_tick_ms": {
            "description": "Dispatch (claim) loop cadence in ms (50-60000).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "metric_tick_secs": {
            "description": "CPU/RSS metric sampling cadence in seconds (1-60).",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "id": "mcp.updateSettings",
      "title": "Update MCP settings",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "mcp::settings::manage",
      "group": "Admin",
      "description": "Update the MCP agent/tool caps (max concurrent control sessions, max in-flight invokes per user, per-action wall-clock backstop, list-capabilities cap, invoke result-byte cap) and the pairing-code TTL. Each field is optional; omit to leave unchanged. Values are bounded (safety limits).",
      "params_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "max_control_sessions": {
            "description": "Global cap on live agent control sessions — an OOM safety limit (16..16384).",
            "type": "integer",
            "minimum": 16,
            "maximum": 16384
          },
          "max_inflight_per_user": {
            "description": "Per-user cap on concurrent in-flight invokes — a DoS safety limit (1..256).",
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "pairing_ttl_secs": {
            "description": "Pairing-code time-to-live, in seconds (30..3600).",
            "type": "integer",
            "minimum": 30,
            "maximum": 3600
          },
          "action_wall_clock_secs": {
            "description": "Outer wall-clock backstop on one dispatched action, in seconds (30..3600).",
            "type": "integer",
            "minimum": 30,
            "maximum": 3600
          },
          "max_list_results": {
            "description": "Cap on capabilities returned by one list_capabilities call (1..2000).",
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "max_result_bytes": {
            "description": "Cap on the invoke result body relayed to the model, in bytes — an OOM safety limit (1 KiB..64 MiB).",
            "type": "integer",
            "minimum": 1024,
            "maximum": 67108864
          }
        }
      }
    },
