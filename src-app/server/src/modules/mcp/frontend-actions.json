    {
      "id": "workstore.updateSettings",
      "title": "Update workstore settings",
      "kind": "global",
      "context": "global",
      "mutating": true,
      "stateful": false,
      "permission": "workstore::settings::manage",
      "group": "Admin",
      "description": "Update the workstore GC policy (sweep on/off, cadence, orphan-grace), ingest size caps (max single-file bytes, max multi-file total bytes), and upload limits (max upload body bytes — SaaS only, max upload parts — both modes). Each field is optional; omit to leave unchanged. Values are bounded (safety limits).",
      "params_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "gc_enabled": {
            "description": "Enable the standing blob-GC sweep.",
            "type": "boolean"
          },
          "gc_interval_hours": {
            "description": "GC sweep cadence, in hours (1..720).",
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          },
          "gc_grace_secs": {
            "description": "Orphan-grace window, in seconds (300..604800).",
            "type": "integer",
            "minimum": 300,
            "maximum": 604800
          },
          "max_output_file_bytes": {
            "description": "Ingest ceiling on a single output file / member, in bytes (1 MiB..64 GiB).",
            "type": "integer",
            "minimum": 1048576,
            "maximum": 68719476736
          },
          "max_multifile_total_bytes": {
            "description": "Ingest ceiling on a multi-file artifact total, in bytes (1 MiB..256 GiB).",
            "type": "integer",
            "minimum": 1048576,
            "maximum": 274877906944
          },
          "max_upload_body_bytes": {
            "description": "SaaS-only ceiling on a dataset UPLOAD request body, in bytes (1 MiB..256 GiB). Self-hosted uploads are uncapped and ignore this value.",
            "type": "integer",
            "minimum": 1048576,
            "maximum": 274877906944
          },
          "max_upload_parts": {
            "description": "Ceiling on the number of parts in one multipart upload, in BOTH modes (1..65536).",
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        }
      }
    }
